<?xml version="1.0"?>
<robot name="hammer">
  <link name="hammer">
    <!-- Origin at handle centre. Handle runs along x-axis so the hand
         grips it with a power grip (handle across the palm) and rotates
         it about the handle's long axis. -->

    <!-- Handle: 12 cm long, 14 mm radius (~real hammer grip size), along x-axis -->
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.014" length="0.12"/>
      </geometry>
      <material name="wood">
        <color rgba="0.8 0.5 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.014" length="0.12"/>
      </geometry>
    </collision>

    <!-- Head: at the +x end of the handle; long face along y (perpendicular
         to handle), so it looks like a real hammer head -->
    <visual>
      <origin xyz="0.075 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.06 0.025"/>
      </geometry>
      <material name="iron">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.075 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.06 0.025"/>
      </geometry>
    </collision>

    <!-- CoM biased toward head end along x -->
    <inertial>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <!-- Ixx (spin about handle axis) tiny; Iyy/Izz account for length -->
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.0003"  iyz="0.0"
               izz="0.0003"/>
    </inertial>
  </link>
</robot>
